NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SITE_URL=https://games.upilinks.in
COOKIE_SECURE=true
# Generate with node scripts/password.mjs. Never commit the actual hash.
ADMIN_PASSWORD_HASH=
# PostgreSQL: set either DATABASE_URL or the PG* fields below. Never commit real values.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/upgames
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Set true only with a trusted PostgreSQL server certificate.
PGSSL=false
DATA_DIR=./data
CMP_SCRIPT_URL=
